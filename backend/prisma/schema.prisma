generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  password     String
  email        String        @unique
  role         String        @default("USER") // e.g., ADMIN, USER
  departmentId Int?
  department   Department?   @relation(fields: [departmentId], references: [id])
  activities   ActivityLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("users")
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("departments")
}

// วัสดุสิ้นเปลือง (Inventory Stock)
model Item {
  id           Int                @id @default(autoincrement())
  sku          String             @unique // รหัสวัสดุ เช่น 'CS-0001'
  name         String             // ชื่อวัสดุ
  description  String?            // คำอธิบายเพิ่มเติม
  category     String?            // หมวดหมู่ เช่น 'กระดาษ'
  unit         String?            // หน่วยนับ เช่น 'รีม', 'ตลับ'
  quantity     Int                @default(0) // ยอดคงเหลือ
  minThreshold Int                @default(0) // จุดเตือนสั่งซื้อ
  unitPrice    Float              @default(0) // ราคาต่อหน่วย
  stockTx      StockTransaction[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("items")
}

// ครุภัณฑ์ (Fixed Asset)
model Asset {
  id                Int       @id @default(autoincrement())
  seq               String    @unique // ลำดับครุภัณฑ์ e.g. "561-001"
  name              String    // ชื่อพัสดุ
  category          String    // หมวดหมู่/ประเภท
  department        String    // แผนก/หน่วยงานที่ครอบครอง
  
  brand             String?   // ยี่ห้อ/รุ่น
  serialNumber      String?   // หมายเลขเครื่อง (Serial Number) / ตัวถัง
  specifications    String?   // คุณสมบัติ/สเปค
  
  acquiredDate      DateTime  // วันที่ได้มา
  acquisitionMethod String    // วิธีการได้มา
  budgetType        String    // แหล่งเงิน
  unitPrice         Float     // ราคาต่อหน่วย
  referenceCode     String?   // หมายเลขพัสดุหลัก / รหัสอ้างอิง e.g. "2310-004-0002"
  
  remark            String?   // หมายเหตุ
  image             String?   // URL รูปภาพ
  status            String    @default("Active") // Active, Repaired, Broken, Scrapped
  
  locationId        Int?
  location          Location? @relation(fields: [locationId], references: [id])
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("assets")
}

model Location {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  assets      Asset[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("locations")
}

model StockTransaction {
  id              Int      @id @default(autoincrement())
  itemId          Int
  item            Item     @relation(fields: [itemId], references: [id])
  transactionType String   // IN, OUT, ADJUSTMENT
  quantity        Int
  reference       String?  // e.g., PO Number, Request ID
  remarks         String?
  createdAt       DateTime @default(now())

  @@map("stock_transactions")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // CREATE, UPDATE, DELETE, LOGIN
  entityType  String   // USER, ASSET, ITEM, etc.
  entityId    String?
  details     String?  // JSON string or description
  createdAt   DateTime @default(now())

  @@map("activity_logs")
}
