generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  password     String
  email        String        @unique
  role         String        @default("USER") // e.g., ADMIN, USER
  departmentId Int?
  department   Department?   @relation(fields: [departmentId], references: [id])
  activities   ActivityLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("users")
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("departments")
}

model Item {
  id          Int                @id @default(autoincrement())
  sku         String             @unique
  name        String
  description String?
  category    String?
  assets      Asset[]
  stockTx     StockTransaction[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("items")
}

model Location {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  assets      Asset[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("locations")
}

model Asset {
  id           Int      @id @default(autoincrement())
  assetCode    String   @unique
  itemId       Int
  item         Item     @relation(fields: [itemId], references: [id])
  locationId   Int?
  location     Location? @relation(fields: [locationId], references: [id])
  status       String   @default("AVAILABLE") // AVAILABLE, IN_USE, MAINTENANCE, RETIRED
  purchaseDate DateTime?
  price        Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("assets")
}

model StockTransaction {
  id              Int      @id @default(autoincrement())
  itemId          Int
  item            Item     @relation(fields: [itemId], references: [id])
  transactionType String   // IN, OUT, ADJUSTMENT
  quantity        Int
  reference       String?  // e.g., PO Number, Request ID
  remarks         String?
  createdAt       DateTime @default(now())

  @@map("stock_transactions")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // CREATE, UPDATE, DELETE, LOGIN
  entityType  String   // USER, ASSET, ITEM, etc.
  entityId    String?
  details     String?  // JSON string or description
  createdAt   DateTime @default(now())

  @@map("activity_logs")
}
