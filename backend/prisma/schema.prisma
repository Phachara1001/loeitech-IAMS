generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   Int           @id @default(autoincrement())
  username             String        @unique
  password             String
  email                String        @unique
  name                 String        @default("")
  role                 String        @default("USER") // e.g., ADMIN, USER
  departmentId         Int?
  department           Department?   @relation(fields: [departmentId], references: [id])
  activities           ActivityLog[]

  // สำหรับฟีเจอร์ลืมรหัสผ่าน: เก็บรหัสยืนยัน 6 หลักและเวลาหมดอายุ
  resetPasswordCode    String?
  resetPasswordExpires DateTime?

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("users")
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("departments")
}

// วัสดุสิ้นเปลือง (Inventory Stock)
model Item {
  id               Int                @id @default(autoincrement())
  sku              String             @unique // รหัสวัสดุ เช่น 'CS-0001'
  name             String             // ชื่อวัสดุ
  description      String?            // คำอธิบายเพิ่มเติม
  category         String?            // หมวดหมู่ เช่น 'กระดาษ'
  unit             String?            // หน่วยนับ เช่น 'รีม', 'ตลับ'
  quantity         Int                @default(0) // ยอดคงเหลือ
  minThreshold     Int                @default(0) // จุดเตือนสั่งซื้อ
  unitPrice        Float              @default(0) // ราคาต่อหน่วย
  stockTx          StockTransaction[]
  requisitionItems RequisitionItem[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("items")
}

// ครุภัณฑ์ (Fixed Asset)
model Asset {
  id                Int       @id @default(autoincrement())
  seq               String    @unique // ลำดับครุภัณฑ์ e.g. "561-001"
  name              String    // ชื่อพัสดุ
  category          String    // หมวดหมู่/ประเภท
  department        String    // แผนก/หน่วยงานที่ครอบครอง
  
  brand             String?   // ยี่ห้อ/รุ่น
  serialNumber      String?   // หมายเลขเครื่อง (Serial Number) / ตัวถัง
  specifications    String?   // คุณสมบัติ/สเปค
  
  acquiredDate      DateTime  // วันที่ได้มา
  acquisitionMethod String    // วิธีการได้มา
  budgetType        String    // แหล่งเงิน
  unitPrice         Float     // ราคาต่อหน่วย
  referenceCode     String?   // หมายเลขพัสดุหลัก / รหัสอ้างอิง e.g. "2310-004-0002"
  
  remark            String?   // หมายเหตุ
  image             String?   // URL รูปภาพ
  status            String    @default("Active") // Active, Repaired, Broken, Scrapped
  
  locationId        Int?
  location          Location? @relation(fields: [locationId], references: [id])
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("assets")
}

model Location {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  assets      Asset[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("locations")
}

model StockTransaction {
  id                  Int       @id @default(autoincrement())
  itemId              Int
  item                Item      @relation(fields: [itemId], references: [id])
  transactionType     String    // IN, OUT, ADJUSTMENT
  quantity            Int
  unitPrice           Float     @default(0) // ราคาต่อหน่วย
  totalPrice          Float     @default(0) // ราคารวม
  receivedDate        DateTime? // วันที่รับตามเอกสาร
  acquisitionMethod   String?   // วิธีการได้มา เช่น สอบราคา, ตกลงราคา
  budgetType          String?   // ประเภทเงิน เช่น เงินงบประมาณ
  operatorName        String?   // ชื่อผู้บันทึก
  reference           String?   // e.g., PO Number, Request ID
  remarks             String?
  requisitionItem     RequisitionItem[]
  createdAt           DateTime  @default(now())

  @@map("stock_transactions")
}

// คำขอเบิกพัสดุ
model Requisition {
  id          Int               @id @default(autoincrement())
  reqCode     String            @unique // เลขที่คำขอ เช่น REQ-2569-0001
  requesterId Int?              // ผู้ยื่นคำขอ (userId)
  reason      String            // เหตุผลการเบิก
  status      String            @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy  String?           // ชื่อผู้อนุมัติ
  approvedAt  DateTime?         // วันที่อนุมัติ
  remark      String?           // หมายเหตุของผู้อนุมัติ
  items       RequisitionItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("requisitions")
}

// รายการพัสดุในคำขอเบิก
model RequisitionItem {
  id               Int              @id @default(autoincrement())
  requisitionId    Int
  requisition      Requisition      @relation(fields: [requisitionId], references: [id])
  itemId           Int
  item             Item             @relation(fields: [itemId], references: [id])
  requestedQty     Int              // จำนวนที่ขอเบิก
  approvedQty      Int?             // จำนวนที่อนุมัติ
  stockTxId        Int?             // อ้างอิง StockTransaction ที่ตัด OUT
  stockTx          StockTransaction? @relation(fields: [stockTxId], references: [id])
  createdAt        DateTime         @default(now())

  @@map("requisition_items")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // CREATE, UPDATE, DELETE, LOGIN
  entityType  String   // USER, ASSET, ITEM, etc.
  entityId    String?
  details     String?  // JSON string or description
  createdAt   DateTime @default(now())

  @@map("activity_logs")
}
