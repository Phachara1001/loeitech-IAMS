generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   Int           @id @default(autoincrement())
  username             String        @unique
  password             String
  email                String        @unique
  name                 String        @default("")
  phone                String?
  position             String?
  avatarUrl            String?
  role                 String        @default("USER") // e.g., ADMIN, USER
  accountStatus        String        @default("ACTIVE") // ACTIVE, PENDING, REJECTED
  departmentId         Int?
  department           Department?   @relation(fields: [departmentId], references: [id])
  activities           ActivityLog[]
  distributions        AssetDistribution[]
  requisitions         Requisition[] @relation(name: "RequisitionRequester")
  approvedRequisitions Requisition[] @relation(name: "RequisitionApprover")

  // สำหรับฟีเจอร์ลืมรหัสผ่าน: เก็บรหัสยืนยัน 6 หลักและเวลาหมดอายุ
  resetPasswordCode    String?
  resetPasswordExpires DateTime?

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("users")
}

model Department {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("departments")
}

// วัสดุสิ้นเปลือง (Inventory Stock)
model Item {
  id               Int                @id @default(autoincrement())
  sku              String             @unique // รหัสวัสดุ เช่น 'CS-0001'
  name             String             // ชื่อวัสดุ
  description      String?            // คำอธิบายเพิ่มเติม
  category         String?            // หมวดหมู่ เช่น 'กระดาษ'
  unit             String?            // หน่วยนับ เช่น 'รีม', 'ตลับ'
  quantity         Int                @default(0) // ยอดคงเหลือ
  minThreshold     Int                @default(0) // จุดเตือนสั่งซื้อ
  unitPrice        Float              @default(0) // ราคาต่อหน่วย
  isDeleted        Boolean            @default(false) // Soft Delete: ซ่อนแทนการลบจริง เพื่อไม่ให้กระทบประวัติ stock transaction
  deletedAt        DateTime?
  stockTx          StockTransaction[]
  requisitionItems RequisitionItem[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("items")
}

// ครุภัณฑ์ (Fixed Asset)
model Asset {
  id                Int       @id @default(autoincrement())
  seq               String    @unique // ลำดับครุภัณฑ์ e.g. "561-001"
  name              String    // ชื่อพัสดุ
  category          String    // หมวดหมู่/ประเภท
  department        String    // แผนก/หน่วยงานที่ครอบครอง
  
  brand             String?   // ยี่ห้อ/รุ่น
  serialNumber      String?   // หมายเลขเครื่อง (Serial Number) / ตัวถัง
  specifications    String?   // คุณสมบัติ/สเปค
  
  acquiredDate      DateTime  // วันที่ได้มา
  acquisitionMethod String    // วิธีการได้มา
  budgetType        String    // แหล่งเงิน
  unitPrice         Float     // ราคาต่อหน่วย
  referenceCode     String?   // หมายเลขพัสดุหลัก / รหัสอ้างอิง e.g. "2310-004-0002"
  
  remark            String?   // หมายเหตุ
  image             String?   // URL รูปภาพ
  status            String    @default("Active") // Active, Repaired, Broken, Scrapped
  
  locationId        Int?
  location          Location? @relation(fields: [locationId], references: [id])
  
  distributions     AssetDistribution[]
  borrows           BorrowTransaction[]
  repairs           RepairRequest[]
  disposalRequests  DisposalRequest[]
   
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("assets")
}

model AssetDistribution {
  id                  Int       @id @default(autoincrement())
  assetId             Int
  asset               Asset     @relation(fields: [assetId], references: [id])
  department          String
  building            String
  room                String
  responsiblePersonId Int
  responsiblePerson   User      @relation(fields: [responsiblePersonId], references: [id])
  assignDate          DateTime  @default(now())
  returnDate          DateTime?
  isCurrent           Boolean   @default(true)
  note                String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("asset_distributions")
}

model Location {
  id          Int      @id @default(autoincrement())
  building    String?  // อาคาร เช่น "อาคาร 1"
  name        String   // ห้อง/พื้นที่ เช่น "101", "คลังพัสดุกลาง"
  type        String?  // ประเภทห้อง เช่น "ห้องเรียน"
  description String?
  assets      Asset[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([building, name])
  @@map("locations")
}

model StockTransaction {
  id                  Int       @id @default(autoincrement())
  itemId              Int
  item                Item      @relation(fields: [itemId], references: [id])
  transactionType     String    // IN, OUT, ADJUSTMENT
  quantity            Int
  unitPrice           Float     @default(0) // ราคาต่อหน่วย
  totalPrice          Float     @default(0) // ราคารวม
  receivedDate        DateTime? // วันที่รับตามเอกสาร
  acquisitionMethod   String?   // วิธีการได้มา เช่น สอบราคา, ตกลงราคา
  budgetType          String?   // ประเภทเงิน เช่น เงินงบประมาณ
  operatorName        String?   // ชื่อผู้บันทึก
  reference           String?   // e.g., PO Number, Request ID
  remarks             String?
  requisitionItem     RequisitionItem[]
  createdAt           DateTime  @default(now())

  @@map("stock_transactions")
}

// คำขอเบิกพัสดุ
model Requisition {
  id          Int               @id @default(autoincrement())
  reqCode     String            @unique // เลขที่คำขอ เช่น REQ-2569-0001
  requesterId Int?              // ผู้ยื่นคำขอ (userId)
  requester   User?             @relation(name: "RequisitionRequester", fields: [requesterId], references: [id])
  reason      String            // เหตุผลการเบิก
  status      String            @default("PENDING") // PENDING, APPROVED, REJECTED
  approverId  Int?              // ผู้อนุมัติ (userId)
  approver    User?             @relation(name: "RequisitionApprover", fields: [approverId], references: [id])
  approvedBy  String?           // ชื่อผู้อนุมัติ (เก็บเป็น text เผื่อไว้)
  approvedAt  DateTime?         // วันที่อนุมัติ
  remark      String?           // หมายเหตุของผู้อนุมัติ
  items       RequisitionItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("requisitions")
}

// รายการพัสดุในคำขอเบิก
model RequisitionItem {
  id               Int              @id @default(autoincrement())
  requisitionId    Int
  requisition      Requisition      @relation(fields: [requisitionId], references: [id])
  itemId           Int
  item             Item             @relation(fields: [itemId], references: [id])
  requestedQty     Int              // จำนวนที่ขอเบิก
  approvedQty      Int?             // จำนวนที่อนุมัติ
  stockTxId        Int?             // อ้างอิง StockTransaction ที่ตัด OUT
  stockTx          StockTransaction? @relation(fields: [stockTxId], references: [id])
  createdAt        DateTime         @default(now())

  @@map("requisition_items")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // INSERT, UPDATE, DELETE, LOGIN
  entityType  String   // USER, ASSET, ITEM, DEPARTMENT, LOCATION, etc.
  entityId    String?
  details     String?  // คำอธิบายสั้น ๆ ของรายการ
  ipAddress   String?  // IP ของผู้ทำรายการ
  oldValue    Json?    // ค่าก่อนแก้ไข (สำหรับ UPDATE/DELETE)
  newValue    Json?    // ค่าหลังแก้ไข (สำหรับ INSERT/UPDATE)
  createdAt   DateTime @default(now())

  @@map("activity_logs")
}

// ประวัติการยืม-คืนครุภัณฑ์
model BorrowTransaction {
  id                Int       @id @default(autoincrement())
  borrowCode        String    @unique // รหัสการยืม เช่น 'BRW-2569-0001'
  assetId           Int
  asset             Asset     @relation(fields: [assetId], references: [id])
  borrowerName      String    // ชื่อผู้ยืม
  borrowerDept      String    // แผนก/หน่วยงานผู้ยืม
  borrowDate        DateTime  // วันที่ยืม
  dueDate           DateTime  // กำหนดส่งคืน
  purpose           String    // วัตถุประสงค์การยืม
  status            String    @default("PENDING") // PENDING, BORROWED, RETURNED, REJECTED
  approvedBy        String?   // ผู้อนุมัติการยืม
  approvedAt        DateTime? // วันอนุมัติยืม
  returnDate        DateTime? // วันที่ส่งคืนจริง
  returnedTo        String?   // ผู้รับคืน
  remark            String?   // หมายเหตุ/เหตุผลปฏิเสธ
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("borrow_transactions")
}

// ใบแจ้งซ่อมครุภัณฑ์พัสดุ
model RepairRequest {
  id           Int       @id @default(autoincrement())
  repairCode   String    @unique // รหัสแจ้งซ่อม เช่น 'REP-2569-0001'
  assetId      Int
  asset        Asset     @relation(fields: [assetId], references: [id])
  reporterName String    // ชื่อผู้แจ้งซ่อม
  description  String    // รายละเอียดความเสียหาย/อาการชำรุด
  urgency      String    @default("NORMAL") // NORMAL, URGENT, CRITICAL
  status       String    @default("PENDING") // PENDING, APPROVED, REPAIRING, COMPLETED, REJECTED
  approvedBy   String?   // ชื่อผู้อนุมัติ/ผู้ดำเนินการซ่อม
  approvedAt   DateTime? // วันที่อนุมัติซ่อม
  repairCost   Float     @default(0.0) // ค่าซ่อมจริง
  finishDate   DateTime? // วันที่เสร็จสิ้นการซ่อม
  remark       String?   // หมายเหตุ/เหตุผลปฏิเสธ
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("repair_requests")
}

// คำขอจำหน่ายพัสดุ/ครุภัณฑ์
model DisposalRequest {
  id           Int       @id @default(autoincrement())
  disposalCode String    @unique // รหัสคำขอจำหน่าย เช่น 'DSP-2569-0001'
  assetId      Int
  asset        Asset     @relation(fields: [assetId], references: [id])
  method       String    // ขายทอดตลาด, บริจาค, โอน, แปรสภาพ, ทำลาย
  meetingDate  DateTime  // วันที่ประชุมคณะกรรมการ
  committee    String    // รายชื่อคณะกรรมการ (คั่นด้วยจุลภาค)
  resolution   String    // มติที่ประชุม
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED, DISPOSED
  requestedBy  String?   // ชื่อผู้สร้างคำขอ
  approvedBy   String?   // ชื่อผู้อนุมัติ
  approvedAt   DateTime?
  disposedAt   DateTime?
  remark       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("disposal_requests")
}